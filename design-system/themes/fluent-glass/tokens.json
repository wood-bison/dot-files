{
  "id": "fluent-glass",
  "name": "Fluent Glass",
  "version": 3,
  "editor": {
    "light": {
      "canvas": "--fel-plate", "chrome": "--fel-field",
      "keyword": "--fel-accent-ink", "type": "--fel-rust", "property": "--fel-warm",
      "comment": "--fel-ink-muted", "bracket": "--fel-ink-muted", "selection": "#d9e6f5",
      "active-line": "--fel-field", "line-number": "--fel-ink-faint",
      "terminal-magenta": "#93416b", "terminal-cyan": "#216b70"
    },
    "dark": {
      "canvas": "--fel-plate", "chrome": "--fel-field",
      "keyword": "--fel-accent-ink", "type": "--fel-rust", "property": "--fel-warm",
      "comment": "--fel-ink-muted", "bracket": "--fel-ink-muted", "selection": "#283e55",
      "active-line": "--fel-plate-muted", "line-number": "--fel-ink-faint",
      "terminal-magenta": "#d7a0c3", "terminal-cyan": "#8dccce"
    }
  },
  "provenance": "Extracted from approved Fluent Notebooks theme on 2026-09-10; our web interpretation, not Apple native tokens.",
  "shared": {
    "font-mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "body-size": "21px",
    "body-wide": "23px",
    "body-mobile": "18px",
    "prose-width": "68ch",
    "heading-weight": "650",
    "heading-tracking": "-0.035em",
    "lesson-title": "clamp(40px, 4vw, 76px)",
    "radius-sheet": "24px",
    "radius-control": "999px",
    "radius-group": "12px",
    "motion-duration": "160ms"
  },
  "appearances": {
    "light": {
      "--fel-font-display": "-apple-system, BlinkMacSystemFont, \"Helvetica Neue\", system-ui, sans-serif",
      "--fel-font-body": "-apple-system, BlinkMacSystemFont, \"Helvetica Neue\", system-ui, sans-serif",
      "--fel-field": "#f5f5f7",
      "--fel-plate": "#ffffff",
      "--fel-plate-muted": "#ececef",
      "--fel-plate-soft": "#f0f0f3",
      "--fel-plate-raised": "#ffffff",
      "--fel-plate-sunken": "#e8e8ed",
      "--fel-ink": "#1d1d1f",
      "--fel-ink-muted": "#626269",
      "--fel-ink-body": "#39393e",
      "--fel-ink-soft": "#626269",
      "--fel-ink-faint": "#6e6e73",
      "--fel-line": "#d6d6dd",
      "--fel-line-soft": "#e8e8ed",
      "--fel-line-strong": "#92929a",
      "--fel-cameo": "#0066cc",
      "--fel-cameo-soft": "#eaf3ff",
      "--fel-accent": "#0066cc",
      "--fel-accent-soft": "#eaf3ff",
      "--fel-accent-strong": "#004f9e",
      "--fel-accent-ink": "#005bb8",
      "--fel-accent-line": "#90b9e5",
      "--fel-accent-contrast": "#ffffff",
      "--fel-olive": "#237344",
      "--fel-sage": "#237344",
      "--fel-sage-soft": "#eaf5ed",
      "--fel-sage-line": "#aacdb5",
      "--fel-terra": "#9b481b",
      "--fel-rust": "#9b481b",
      "--fel-rust-soft": "#fff0e6",
      "--fel-rust-line": "#d9b499",
      "--fel-danger": "#b22b30",
      "--fel-warm": "#805b0b",
      "--fel-warm-soft": "#fff5d9",
      "--fel-warm-line": "#d8c385",
      "--fel-code-surface": "#f5f5f7",
      "--fel-code-gutter": "#ebebf0",
      "--fel-code-ink": "#27272c",
      "--fel-surface-control": "rgb(255 255 255 / 86%)",
      "--fel-surface-control-strong": "rgb(255 255 255 / 94%)",
      "--fel-glass-functional": "color-mix( in srgb, var(--fel-plate) var(--glass-opacity, 86%), transparent )",
      "--fel-glass-functional-strong": "color-mix(in srgb, var(--fel-plate) 94%, transparent)",
      "--fel-glass-inspector": "var(--fel-plate)",
      "--fel-glass-highlight": "rgb(255 255 255 / 95%)",
      "--fel-glass-border": "rgb(255 255 255 / 70%)",
      "--fel-glass-blur": "28px",
      "--fel-glass-saturation": "140%",
      "--fel-shadow-control": "0 10px 32px rgb(25 30 45 / 10%)",
      "--fel-shadow": "0 28px 70px rgb(25 30 45 / 12%)",
      "--glass-edge": "inset 0 1px 0 rgb(255 255 255 / 92%), inset 0 -1px 0 rgb(0 0 0 / 7%)",
      "--glass-cover": "#143e65",
      "--glass-cover-edge": "#5487ad"
    },
    "dark": {
      "--fel-font-display": "-apple-system, BlinkMacSystemFont, \"Helvetica Neue\", system-ui, sans-serif",
      "--fel-font-body": "-apple-system, BlinkMacSystemFont, \"Helvetica Neue\", system-ui, sans-serif",
      "--fel-field": "#101012",
      "--fel-plate": "#1c1c1e",
      "--fel-plate-muted": "#29292d",
      "--fel-plate-soft": "#18181b",
      "--fel-plate-raised": "#2c2c30",
      "--fel-plate-sunken": "#08080a",
      "--fel-ink": "#f5f5f7",
      "--fel-ink-muted": "#b1b1b8",
      "--fel-ink-body": "#dddde2",
      "--fel-ink-soft": "#b1b1b8",
      "--fel-ink-faint": "#a1a1aa",
      "--fel-line": "#3d3d43",
      "--fel-line-soft": "#2e2e33",
      "--fel-line-strong": "#787881",
      "--fel-cameo": "#72b7ff",
      "--fel-cameo-soft": "#1b3047",
      "--fel-accent": "#72b7ff",
      "--fel-accent-soft": "#1b3047",
      "--fel-accent-strong": "#9bcdff",
      "--fel-accent-ink": "#8ac4ff",
      "--fel-accent-line": "#3f6790",
      "--fel-accent-contrast": "#101012",
      "--fel-olive": "#84d6a0",
      "--fel-sage": "#84d6a0",
      "--fel-sage-soft": "#1c3325",
      "--fel-sage-line": "#416c4f",
      "--fel-terra": "#ffb78d",
      "--fel-rust": "#ffb78d",
      "--fel-rust-soft": "#3b2922",
      "--fel-rust-line": "#765340",
      "--fel-danger": "#ff999c",
      "--fel-warm": "#f3d57a",
      "--fel-warm-soft": "#342e1d",
      "--fel-warm-line": "#796a36",
      "--fel-code-surface": "#141417",
      "--fel-code-gutter": "#202025",
      "--fel-code-ink": "#eeeef2",
      "--fel-surface-control": "rgb(38 38 42 / 86%)",
      "--fel-surface-control-strong": "rgb(38 38 42 / 94%)",
      "--fel-glass-functional": "color-mix( in srgb, var(--fel-plate) var(--glass-opacity, 86%), transparent )",
      "--fel-glass-functional-strong": "color-mix(in srgb, var(--fel-plate) 94%, transparent)",
      "--fel-glass-inspector": "var(--fel-plate)",
      "--fel-glass-highlight": "rgb(255 255 255 / 13%)",
      "--fel-glass-border": "rgb(255 255 255 / 13%)",
      "--fel-glass-blur": "28px",
      "--fel-glass-saturation": "140%",
      "--fel-shadow-control": "0 12px 40px rgb(0 0 0 / 28%)",
      "--fel-shadow": "0 28px 70px rgb(0 0 0 / 40%)",
      "--glass-edge": "inset 0 1px 0 rgb(255 255 255 / 16%), inset 0 -1px 0 rgb(0 0 0 / 40%)",
      "--glass-cover": "#142d43",
      "--glass-cover-edge": "#3f6280"
    }
  },
  "zed": {
    "background": "editor:canvas",
    "editor.background": "editor:canvas",
    "editor.foreground": "--fel-code-ink",
    "editor.gutter.background": "editor:canvas",
    "editor.line_number": "editor:line-number",
    "editor.active_line_number": "--fel-accent-ink",
    "editor.active_line.background": "editor:active-line",
    "text": "--fel-ink",
    "text.muted": "--fel-ink-muted",
    "text.accent": "--fel-accent-ink",
    "border": "--fel-line",
    "border.focused": "--fel-accent",
    "surface.background": "--fel-plate",
    "elevated_surface.background": "--fel-plate-raised",
    "panel.background": "editor:chrome",
    "status_bar.background": "editor:chrome",
    "title_bar.background": "editor:chrome",
    "toolbar.background": "--fel-plate",
    "tab_bar.background": "editor:chrome",
    "tab.active_background": "--fel-plate",
    "tab.inactive_background": "editor:chrome",
    "element.background": "--fel-plate",
    "element.hover": "--fel-plate-muted",
    "element.selected": "editor:selection",
    "error": "--fel-danger",
    "warning": "--fel-warm",
    "success": "--fel-sage",
    "info": "--fel-accent-ink"
  },
  "syntax": {
    "keyword": "editor:keyword",
    "type": "editor:type",
    "function": "--fel-accent-strong",
    "string": "--fel-sage",
    "number": "--fel-rust",
    "boolean": "--fel-rust",
    "comment": "editor:comment",
    "variable": "--fel-code-ink",
    "property": "editor:property",
    "operator": "--fel-ink-body",
    "punctuation": "--fel-ink-muted"
  }
}
