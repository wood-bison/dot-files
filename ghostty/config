# Fluent Glass: native system appearance, opaque reading surface.
theme = light:fluent-glass-light,dark:fluent-glass-dark
background-opacity = 1
background-blur = false
minimum-contrast = 1
faint-opacity = 1

# Typography, window behavior and existing keyboard shortcuts.
font-family = Maple Mono NF
font-size = 14
font-thicken = false
font-family-italic = Maple Mono NF Italic
font-feature = cv05
font-feature = cv38
font-feature = cv02
font-feature = cv31
font-feature = cv62
font-feature = cv65
font-feature = cv61
adjust-cell-height = 8%
window-padding-x = 18
window-padding-y = 16
window-decoration = true
macos-titlebar-proxy-icon = hidden
title = " "
window-save-state = always
cursor-style = bar
cursor-style-blink = false
scrollback-limit = 50000
unfocused-split-opacity = 0.55
keybind = opt+shift+h=new_split:left
keybind = opt+shift+j=new_split:down
keybind = opt+shift+k=new_split:up
keybind = opt+shift+l=new_split:right
keybind = opt+h=goto_split:left
keybind = opt+j=goto_split:bottom
keybind = opt+k=goto_split:top
keybind = opt+l=goto_split:right
keybind = ctrl+shift+h=resize_split:left,20
keybind = ctrl+shift+j=resize_split:down,20
keybind = ctrl+shift+k=resize_split:up,20
keybind = ctrl+shift+l=resize_split:right,20
keybind = opt+shift+e=equalize_splits
keybind = opt+z=toggle_split_zoom
keybind = opt+w=close_surface
keybind = opt+1=goto_tab:1
keybind = opt+2=goto_tab:2
keybind = opt+3=goto_tab:3
keybind = opt+4=goto_tab:4
keybind = opt+5=goto_tab:5
macos-option-as-alt = true
keybind = ctrl+left_bracket=text:\x1b
keybind = shift+enter=text:\x1b\r
keybind = alt+up=esc:[1;3A
keybind = alt+down=esc:[1;3B
keybind = alt+left=esc:[1;3D
keybind = alt+right=esc:[1;3C
mouse-hide-while-typing = true
copy-on-select = true
alpha-blending = linear-corrected
window-padding-balance = true
window-padding-color = extend
split-preserve-zoom = navigation
undo-timeout = 30s
shell-integration-features = cursor,no-sudo,title,ssh-env,ssh-terminfo
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 20s
quick-terminal-position = top
quick-terminal-animation-duration = 0.15
quick-terminal-screen = mouse
keybind = global:cmd+shift+grave_accent=toggle_quick_terminal
keybind = super+ctrl+m=toggle_maximize
keybind = super+ctrl+f=toggle_window_float_on_top
keybind = super+ctrl+s=write_scrollback_file:open,plain
keybind = super+ctrl+i=inspector:toggle

# Machine-specific overrides (optional, never replaced by the installer).
config-file = ?~/.config/ghostty/local.conf
